{
    "manifest_version": 3,
    "name": "flaneur",
    "version": "0.1.1",
    "description": "Lets AI agents running flaneur on this computer browse in this Chrome.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "key": "",
    "permissions": ["debugger", "tabs", "nativeMessaging", "storage", "alarms"],
    "background": {
        "service_worker": "dist/serviceWorker.js",
        "type": "module"
    },
    "action": {
        "default_title": "flaneur",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    }
}
