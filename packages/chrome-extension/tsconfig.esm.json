{
    "extends": "@nzyme/tsconfig/esm.json",
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["chrome", "bun"],
        // The extension runs from bundles (`bundle`); the compiler only checks it.
        "emitDeclarationOnly": true,
        "outDir": "./dist/types",
        "rootDir": "."
    },
    "include": ["src", "scripts"]
}
