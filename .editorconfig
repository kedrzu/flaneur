root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,html,vue}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Claude Code rewrites it with 2-space JSON (see .oxfmtrc.json).
[.claude/settings.json]
indent_size = 2
